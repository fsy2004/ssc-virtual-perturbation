; Frozen 8KCT-O6U application-study production protocol v1.
; Exact CHARMM-GUI HMR topology; 500 ns per velocity-seeded realization.
integrator              = md
dt                      = 0.004
nsteps                  = 125000000
continuation            = yes
gen-vel                 = no
pbc                     = xyz
periodic-molecules      = no

; output every 20 ps
nstxout-compressed      = 5000
compressed-x-precision  = 1000
nstxout                 = 0
nstvout                 = 0
nstfout                 = 0
nstcalcenergy           = 100
nstenergy               = 5000
nstlog                  = 5000

; CHARMM-compatible nonbonded treatment
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.2
vdwtype                 = Cut-off
vdw-modifier            = Force-switch
rvdw-switch             = 1.0
rvdw                    = 1.2
DispCorr                = no
coulombtype             = PME
rcoulomb                = 1.2
pme-order               = 4
fourierspacing          = 0.12

; proper canonical ensemble; fixed generated-system temperature
tcoupl                  = v-rescale
tc-grps                 = SOLU MEMB SOLV
tau-t                   = 1.0 1.0 1.0
ref-t                   = 303.15 303.15 303.15

; membrane-appropriate semi-isotropic pressure coupling
pcoupl                  = C-rescale
pcoupltype              = semiisotropic
tau-p                   = 5.0
compressibility         = 4.5e-5 4.5e-5
ref-p                   = 1.0 1.0

constraints             = h-bonds
constraint-algorithm    = LINCS
lincs-iter              = 1
lincs-order             = 4
lincs-warnangle         = 30

nstcomm                 = 100
comm-mode               = linear
comm-grps               = SOLU_MEMB SOLV
